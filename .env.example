# =========================
# .env.example
# (copy to .env and fill in)
# =========================
ANTHROPIC_API_KEY=your_anthropic_key_here

# Gmail SMTP (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_TO=your_email@gmail.com

# Calendar (secret iCal URLs)
PRIMARY_CALENDAR_ICAL=https://calendar.google.com/calendar/ical/your_secret_url/basic.ics
SECONDARY_CALENDAR_ICAL=https://calendar.google.com/calendar/ical/your_other_secret_url/basic.ics

# Weather
OPENWEATHER_API_KEY=your_openweather_key_here
OPENWEATHER_CITY=Las Vegas
OPENWEATHER_COUNTRY=US

# Timezone
LOCAL_TZ=America/Los_Angeles

# Paths for second brain
VAULT_ROOT=./vault          # put ALL docs here (contracts, PDFs, bills, notes, exports)
NOTION_EXPORT_DIR=./vault/notion
YOUTUBE_LOG=./vault/logs/youtube.csv
BOOK_LOG=./vault/logs/books.csv
SEARCH_LOG=./vault/logs/searches.csv
TASK_LOG=./vault/logs/tasks.csv
