# Personal AI Assistant - Environment Variables
# IMPORTANT: Copy this to .env and fill in your values
# NEVER commit .env to Git

# ==================================================
# CLAUDE API
# ==================================================
# Get from: https://console.anthropic.com
CLAUDE_API_KEY=your-claude-api-key-here

# ==================================================
# GOOGLE OAUTH
# ==================================================
# Get from: https://console.cloud.google.com
# Download as JSON from "Create Credentials" → "OAuth 2.0 Client IDs"
GOOGLE_CREDENTIALS_FILE=config/credentials.json

# ==================================================
# LOCAL SERVER
# ==================================================
# Which port to run the FastAPI server on
SERVER_PORT=8000

# Your computer's local IP (for iPhone access)
# Example: 192.168.1.100
LOCAL_IP=localhost

# ==================================================
# OPTIONAL: GOOGLE MAPS API
# ==================================================
# Only needed if you want to use Maps features
# Get from: https://console.cloud.google.com → APIs → Maps
GOOGLE_MAPS_API_KEY=optional-maps-key

# ==================================================
# LOGGING
# ==================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file location
LOG_FILE=logs/activity.log

# ==================================================
# SECURITY
# ==================================================
# Secret key for encrypting OAuth tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=generate-with-python-secrets

# Enable or disable confirmation prompts
REQUIRE_CONFIRMATION_FOR_SEND=true
REQUIRE_CONFIRMATION_FOR_DELETE=true
REQUIRE_CONFIRMATION_FOR_MODIFY=true

# ==================================================
# DEVELOPMENT
# ==================================================
# Set to true to enable debug logging
DEBUG=false

# Allow CORS from these origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
